{
  "name": "siko-coffee",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "check:cron": "node scripts/check-cron-schedule.mjs",
    "check:toolchain": "node scripts/check-build-toolchain.mjs",
    "check:sst": "tsc -p tsconfig.sst.json",
    "verify:image-optimizer": "node scripts/check-image-optimizer.mjs",
    "sst:deploy": "bash scripts/deploy.sh",
    "prebuild": "node scripts/check-cron-schedule.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sst-config": "node scripts/check-sst-config.mjs",
    "check:secret-file": "node scripts/check-secret-file.mjs"
  },
  "dependencies": {
    "@auth/dynamodb-adapter": "^2.11.3",
    "@aws-sdk/client-dynamodb": "^3.1052.0",
    "@aws-sdk/client-rekognition": "^3.1073.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/client-ses": "^3.1055.0",
    "@aws-sdk/lib-dynamodb": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@next/third-parties": "^16.2.7",
    "@sentry/nextjs": "^10.57.0",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "ogl": "^1.0.11",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "split-type": "^0.3.4",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": ">=8.5.26",
    "minimatch@^3": {
      "brace-expansion": ">=1.1.17 <2"
    },
    "minimatch@^8": {
      "brace-expansion": ">=2.1.3 <3"
    },
    "minimatch@^10": {
      "brace-expansion": ">=5.0.9 <6"
    },
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@opennextjs/aws": "^4.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sst": "^4.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "@sentry/cli": true,
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
